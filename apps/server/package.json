{
  "name": "@repo/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "exports": {
    "./data": "./.adonisjs/client/data.d.ts",
    "./registry": "./.adonisjs/client/registry/index.ts"
  },
  "scripts": {
    "build": "node ace build --ignore-ts-errors",
    "dev": "node ace serve --hmr",
    "test": "node ace test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "queue:work": "node ace queue:work",
    "db:migrate": "drizzle-kit migrate"
  },
  "imports": {
    "#app/*": "./app/*.js",
    "#core/*": "./app/core/*.js",
    "#medication/*": "./app/medication/*.js",
    "#schedule/*": "./app/schedule/*.js",
    "#auth/*": "./app/auth/*.js",
    "#jobs/*": "./app/jobs/*.js",
    "#discord/*": "./app/discord/*.js",
    "#controllers/*": "./app/controllers/*.js",
    "#exceptions/*": "./app/exceptions/*.js",
    "#models/*": "./app/models/*.js",
    "#mails/*": "./app/mails/*.js",
    "#services/*": "./app/services/*.js",
    "#listeners/*": "./app/listeners/*.js",
    "#events/*": "./app/events/*.js",
    "#middleware/*": "./app/middleware/*.js",
    "#validators/*": "./app/validators/*.js",
    "#providers/*": "./providers/*.js",
    "#policies/*": "./app/policies/*.js",
    "#abilities/*": "./app/abilities/*.js",
    "#generated/*": "./.adonisjs/server/*.js",
    "#transformers/*": "./app/transformers/*.js",
    "#database/*": "./database/*.js",
    "#start/*": "./start/*.js",
    "#tests/*": "./tests/*.js",
    "#config/*": "./config/*.js"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.4.0",
    "@adonisjs/tsconfig": "^2.0.0",
    "@japa/api-client": "^3.2.1",
    "@japa/assert": "^4.2.0",
    "@japa/plugin-adonisjs": "^5.2.0",
    "@japa/runner": "^5.3.0",
    "@poppinss/ts-exec": "^1.4.4",
    "@repo/eslint-config": "workspace:^",
    "@repo/prettier-config": "workspace:^",
    "@tuyau/utils": "^0.0.9",
    "@types/luxon": "^3.7.4",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "eslint": "catalog:",
    "hot-hook": "^1.0.0",
    "pino-pretty": "^13.1.3",
    "prettier": "catalog:",
    "typescript": "~6.0.3",
    "youch": "^4.1.1"
  },
  "dependencies": {
    "@adonisjs/ally": "^6.3.0",
    "@adonisjs/auth": "^10.1.0",
    "@adonisjs/core": "^7.4.0",
    "@adonisjs/cors": "^3.0.0",
    "@adonisjs/queue": "^0.6.2",
    "@adonisjs/redis": "^10.0.0",
    "@adonisjs/static": "^2.0.1",
    "@discordjs/rest": "^2.6.3",
    "@repo/discord": "workspace:^",
    "@tuyau/core": "^1.2.2",
    "@vinejs/vine": "^4.4.0",
    "discord-api-types": "^0.38.53",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "luxon": "^3.7.2",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "zod": "^4.4.3"
  },
  "hotHook": {
    "boundaries": [
      "./app/**/controllers/**/*.ts",
      "./app/**/middleware/**/*.ts"
    ]
  },
  "prettier": "@repo/prettier-config"
}
